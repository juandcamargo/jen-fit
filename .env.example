# Supabase Postgres. Get both from your project's "Connect" button →
# ORMs → Prisma. DATABASE_URL is the pooled/transaction connection (port
# 6543, ?pgbouncer=true); DIRECT_URL is the direct connection (port 5432)
# that `prisma migrate` needs.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Open Food Facts (no API key required)
OPEN_FOOD_FACTS_BASE_URL="https://world.openfoodfacts.org"
OPEN_FOOD_FACTS_USER_AGENT="JenFit/1.0 (https://example.com; contact via app support)"

# Which nutrition provider src/lib/food/provider.ts should use.
FOOD_PROVIDER="openfoodfacts"
